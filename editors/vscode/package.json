{
  "name": "jianpu-dsl",
  "displayName": "简谱 DSL",
  "description": "简谱 DSL 的语法高亮、诊断与补全（复用 mpp 解析器）",
  "version": "1.0.0",
  "publisher": "local",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "jianpu",
      "aliases": ["简谱 DSL", "jianpu"],
      "extensions": [".dsl"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "jianpu",
      "scopeName": "source.jianpu",
      "path": "./syntaxes/jianpu.tmLanguage.json"
    }],
    "configuration": {
      "title": "简谱 DSL",
      "properties": {
        "jianpu.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "用于启动 LSP server 的 Python 解释器路径"
        }
      }
    }
  },
  "activationEvents": ["onLanguage:jianpu"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node build.js",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.25.0",
    "vscode-languageclient": "^9.0.1"
  }
}
